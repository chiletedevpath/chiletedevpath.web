---
import "../styles/pages/ruta.css";

const { stage, lang = "es" } = Astro.props;
const labels = lang === "en"
  ? {
      technologies: "Technologies and concepts in this stage",
      contents: "Published topic blocks",
      progress: "Stage progress",
      result: "Result",
    }
  : {
      technologies: "Tecnologías y conceptos de la etapa",
      contents: "Bloques temáticos publicados",
      progress: "Avance de etapa",
      result: "Resultado",
    };
---

<article class="ruta-etapa">
  <span class="ruta-numero">{stage.number}</span>
  <span class="ruta-meta">{stage.intent}</span>
  <h3>{stage.title}</h3>
  {Array.isArray(stage.technologies) && (
    <div class="ruta-tecnologias" aria-label={labels.technologies}>
      {stage.technologies.map((tech) => <span>{tech}</span>)}
    </div>
  )}
  <ol class="ruta-lista">
    {stage.topics.map((topic) => (
      <li>
        <a href={topic.href} target="_blank" rel="noopener noreferrer">{topic.label}</a>
      </li>
    ))}
  </ol>
  <p class="ruta-contenidos">
    <span>{labels.contents}</span>
    <strong>{stage.contentCount}</strong>
  </p>
  {typeof stage.progress === "number" && (
    <div class="ruta-avance" aria-label={`${labels.progress} ${stage.progress}%`}>
      <div>
        <span>{labels.progress}</span>
        <strong>{stage.progress}%</strong>
      </div>
      <div class="ruta-avance-barra">
        <span style={`width: ${stage.progress}%`}></span>
      </div>
    </div>
  )}
  <p class="ruta-resultado">{labels.result}: {stage.result}</p>
  <div class="ruta-pie">
    <span class="estado estado-etapa">{stage.status}</span>
    <a href={stage.href} target="_blank" rel="noopener noreferrer">{stage.action}</a>
  </div>
</article>
