---
const { project, lang = "es", featured = false } = Astro.props;
const detailHref = lang === "en" ? `/en/proyectos/${project.slug}/` : `/proyectos/${project.slug}/`;
const tags = project.filterTags ?? [project.routeStage];
const searchText = [
  project.title,
  project.description,
  project.course,
  project.type,
  ...project.technologies,
].join(" ").toLowerCase();
---

<article
  class:list={["catalogo-proyecto", { "catalogo-proyecto-destacado": featured }]}
  data-project-card="true"
  data-project-filters={tags.filter(Boolean).join(" ")}
  data-project-search-text={searchText}
>
  <a
    class="catalogo-proyecto-imagen"
    href={detailHref}
    aria-label={`${lang === "en" ? "View" : "Ver"} ${project.title}`}
  >
    <img src={project.imageSrc} alt="" loading="lazy" width="720" height="420" />
    <span>{project.visual}</span>
  </a>

  <div class="catalogo-proyecto-contenido">
    <div class="catalogo-proyecto-cabecera">
      <span class="catalogo-proyecto-tipo">{project.type}</span>
      {featured && (
        <span class="catalogo-proyecto-destacado-etiqueta">
          {lang === "en" ? "Featured case" : "Caso destacado"}
        </span>
      )}
    </div>

    <div>
      <p class="catalogo-proyecto-contexto">{project.routeLabel}</p>
      <h3><a href={detailHref}>{project.title}</a></h3>
      <p>{project.description}</p>
    </div>

    <div class="proyecto-tech" aria-label={lang === "en" ? "Technologies" : "Tecnologías"}>
      {project.technologies.slice(0, 5).map((tech) => <span>{tech}</span>)}
    </div>

    <div class="catalogo-proyecto-pie">
      <span class="catalogo-proyecto-estado"><i aria-hidden="true"></i>{project.status}</span>
      <a class="catalogo-proyecto-enlace" href={detailHref}>
        {lang === "en" ? "View technical case" : "Ver caso técnico"}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
