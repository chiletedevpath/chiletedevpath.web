---
import { getTechnologyRoutes } from "../data/ruta.js";

const lang = Astro.props.lang === "en" ? "en" : "es";
const defaultRoutes = getTechnologyRoutes(lang);
const {
  eyebrow = lang === "en" ? "From Chilete, Cajamarca · technology learning" : "Desde Chilete, Cajamarca · aprendizaje tecnológico",
  titlePrimary = lang === "en" ? "Learning technology" : "Aprender tecnología",
  titleAccent = lang === "en" ? "also means learning to decide" : "también es aprender a decidir",
  description = lang === "en" ? "A space to study with order, practice with intention and turn learning into work that can be explained." : "Un espacio para estudiar con orden, practicar con intención y convertir lo aprendido en trabajo que pueda explicarse.",
  primaryHref = "#rutas",
  primaryLabel = lang === "en" ? "Explore paths" : "Explorar las rutas",
  secondaryHref = "/proyectos/",
  secondaryLabel = lang === "en" ? "View projects" : "Ver proyectos",
  technologyRoutes = defaultRoutes,
} = Astro.props;
---

<section id="inicio" class="hero home-hero">
  <div class="home-hero-photo" aria-hidden="true"></div>
  <div class="home-hero-overlay" aria-hidden="true"></div>
  <div class="contenedor home-hero-shell">
    <div class="home-hero-copy">
      <p class="etiqueta">{eyebrow}</p>
      <h1><span>{titlePrimary}</span><span>{titleAccent}</span></h1>
      <p class="hero-descripcion">{description}</p>
      <div class="acciones">
        <a class="boton boton-principal" href={primaryHref}>{primaryLabel}<span aria-hidden="true">→</span></a>
        <a class="boton boton-secundario" href={secondaryHref}>{secondaryLabel}<span aria-hidden="true">↘</span></a>
      </div>
    </div>

    <aside class="learning-atlas" aria-label={lang === "en" ? "Technology learning map" : "Mapa de aprendizaje tecnológico"}>
      <div class="learning-atlas-head">
        <div>
          <span>{lang === "en" ? "LEARNING MAP" : "MAPA DE APRENDIZAJE"}</span>
          <small>{lang === "en" ? "Areas that grow with evidence" : "Áreas que crecen con evidencia"}</small>
        </div>
        <b>{String(technologyRoutes.length).padStart(2, "0")} {lang === "en" ? "PATHS" : "RUTAS"}</b>
      </div>
      <div class="learning-atlas-body">
        <div class="learning-atlas-origin">
          <span>{lang === "en" ? "STARTING POINT" : "PUNTO DE PARTIDA"}</span>
          <strong>{lang === "en" ? "Learn with intention" : "Aprender con intención"}</strong>
        </div>
        <div class="atlas-line atlas-line-main" aria-hidden="true"></div>
        <div class="atlas-junction" aria-hidden="true"></div>
        {technologyRoutes.map((route, index) => (
          <a class:list={["atlas-route", `atlas-route-${index + 1}`]} href={route.href} target={route.href.startsWith("http") ? "_blank" : undefined} rel={route.href.startsWith("http") ? "noopener noreferrer" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>
              <small>{route.statusLabel}</small>
              <strong>{route.title}</strong>
              <em>{route.atlasDescription}</em>
            </span>
          </a>
        ))}
      </div>
      <div class="learning-atlas-foot">
        <p>{lang === "en" ? "New areas are only added when there is real, reviewable practice to share." : "Las áreas nuevas solo se incorporan cuando existe práctica real y revisable para compartir."}</p>
        <a href={primaryHref}>{lang === "en" ? "Choose a path" : "Elegir una ruta"}<span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </div>
</section>
