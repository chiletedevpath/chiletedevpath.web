---
const { project } = Astro.props;
const normalizedAction = project.action?.toLowerCase() ?? "";
const isEnglish = normalizedAction.startsWith("view") || normalizedAction.startsWith("explore");
const labels = isEnglish
  ? {
      technologies: "Project technologies",
      capabilities: "Core capabilities",
      progress: "Project progress",
      problem: "Problem addressed",
      learned: "Demonstrated learning",
      improve: "Next evolution",
    }
  : {
      technologies: "Tecnologías del proyecto",
      capabilities: "Capacidades principales",
      progress: "Avance del proyecto",
      problem: "Problema abordado",
      learned: "Aprendizaje demostrado",
      improve: "Siguiente evolución",
    };
const projectFilters = project.filterTags ?? [project.routeStage];
---

<article
  class="tarjeta tarjeta-con-enlace"
  data-project-card={project.routeStage ? "true" : undefined}
  data-project-filters={projectFilters.filter(Boolean).join(" ")}
>
  {project.imageSrc ? (
    <figure class="proyecto-visual proyecto-visual-imagen">
      <img src={project.imageSrc} alt={project.imageAlt ?? ""} loading="lazy" />
      {project.visual && <figcaption>{project.visual}</figcaption>}
    </figure>
  ) : project.visual && (
    <div class="proyecto-visual">
      <span>{project.visual}</span>
    </div>
  )}
  <span class="estado">{project.status}</span>
  {project.routeLabel && <span class="proyecto-nivel">{project.routeLabel}</span>}
  {typeof project.progress === "number" && (
    <div class="avance-proyecto" aria-label={`${labels.progress}: ${project.progress}%`}>
      <div class="avance-proyecto-barra">
        <span style={`width: ${project.progress}%`}></span>
      </div>
      <strong>{project.progress}%</strong>
    </div>
  )}
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  {Array.isArray(project.technologies) && (
    <div class="proyecto-tech" aria-label={labels.technologies}>
      {project.technologies.map((tech) => <span>{tech}</span>)}
    </div>
  )}
  <span class="proyecto-bloque-titulo">{labels.capabilities}</span>
  <ul class="tarjeta-detalles">
    {project.details.map((detail) => <li>{detail}</li>)}
  </ul>
  {(project.problem || project.learned || project.improve) && (
    <div class="proyecto-ficha">
      {project.problem && (
        <div>
          <span>{labels.problem}</span>
          <p>{project.problem}</p>
        </div>
      )}
      {project.learned && (
        <div>
          <span>{labels.learned}</span>
          <p>{project.learned}</p>
        </div>
      )}
      {project.improve && (
        <div>
          <span>{labels.improve}</span>
          <p>{project.improve}</p>
        </div>
      )}
    </div>
  )}
  <a class="boton boton-principal" href={project.href} target="_blank" rel="noopener noreferrer">
    {project.action}
  </a>
</article>
