---
import {
  siAstro,
  siCss,
  siHtml5,
  siJavascript,
  siPhp,
  siPostgresql,
  siSpringboot,
} from "simple-icons";

const { name } = Astro.props;

const icons = {
  HTML: siHtml5,
  CSS: siCss,
  JavaScript: siJavascript,
  PHP: siPhp,
  PostgreSQL: siPostgresql,
  "Spring Boot": siSpringboot,
  Astro: siAstro,
};

const icon = icons[name];
const isJava = name === "Java";
---

{(icon || isJava) && (
  <span
    class:list={["tech-icono", { "tech-icono-java": isJava }]}
    style={`--tech-brand: ${isJava ? "#e76f00" : `#${icon.hex}`}`}
    title={isJava ? "Java" : icon.title}
  >
    {isJava ? (
      <img src="/assets/img/technologies/java-original.svg" alt="" aria-hidden="true" />
    ) : (
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d={icon.path} />
      </svg>
    )}
  </span>
)}
