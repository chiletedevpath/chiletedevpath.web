---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/rutas-atlas.css";
import "../styles/pages/composiciones.css";
import RouteHero from "../components/RouteHero.astro";
import RouteDirectory from "../components/RouteDirectory.astro";
import TechnologyDirectory from "../components/TechnologyDirectory.astro";
import { getLearningPaths, getTechStack } from "../data/ruta.js";

const paths = getLearningPaths("es");
const technologies = getTechStack("es");
---

<BaseLayout
  title="Rutas de aprendizaje | Chilete DevPath"
  description="Dos rutas de aprendizaje publicadas: desarrollo de software y productividad con datos, organizadas por evidencia verificable."
>
  <RouteHero lang="es" paths={paths} />
  <RouteDirectory lang="es" paths={paths} />
  <TechnologyDirectory lang="es" technologies={technologies} />
</BaseLayout>
