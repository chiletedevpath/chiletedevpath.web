---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomeEditorial from "../components/HomeEditorial.astro";
import "../styles/pages/inicio.css";
import { getTechnologyRoutes } from "../data/ruta.js";

const technologyRoutes = getTechnologyRoutes("es");
---

<BaseLayout>
  <Hero
    eyebrow="Desde Chilete, Cajamarca · aprendizaje tecnológico"
    titlePrimary="Aprender tecnología"
    titleAccent="también es aprender a decidir"
    description="Un espacio para estudiar con orden, practicar con intención y convertir lo aprendido en trabajo que pueda explicarse."
    primaryHref="#rutas"
    primaryLabel="Explorar las rutas"
    secondaryHref="/proyectos/"
    secondaryLabel="Ver proyectos"
    technologyRoutes={technologyRoutes}
  />
  <HomeEditorial lang="es" />
</BaseLayout>
