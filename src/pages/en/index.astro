---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import HomeEditorial from "../../components/HomeEditorial.astro";
import "../../styles/pages/inicio.css";
import { getTechnologyRoutes } from "../../data/ruta.js";

const technologyRoutes = getTechnologyRoutes("en");
---

<BaseLayout title="Chilete DevPath | Learning path">
  <Hero
    lang="en"
    eyebrow="From Chilete, Cajamarca · technology learning"
    titlePrimary="Learning technology"
    titleAccent="also means learning to decide"
    description="A space to study with order, practice with intention and turn learning into work that can be explained."
    primaryHref="#rutas"
    primaryLabel="Explore paths"
    secondaryHref="/en/proyectos/"
    secondaryLabel="View projects"
    technologyRoutes={technologyRoutes}
  />
  <HomeEditorial lang="en" />
</BaseLayout>
