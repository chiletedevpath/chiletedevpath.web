---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/pages/rutas-atlas.css";
import "../../styles/pages/composiciones.css";
import RouteHero from "../../components/RouteHero.astro";
import RouteDirectory from "../../components/RouteDirectory.astro";
import TechnologyDirectory from "../../components/TechnologyDirectory.astro";
import { getLearningPaths, getTechStack } from "../../data/ruta.js";

const paths = getLearningPaths("en");
const technologies = getTechStack("en");
---

<BaseLayout
  title="Learning routes | Chilete DevPath"
  description="Two published learning routes: software development and productivity with data, organized around verifiable evidence."
  lang="en"
>
  <RouteHero lang="en" paths={paths} />
  <RouteDirectory lang="en" paths={paths} />
  <TechnologyDirectory lang="en" technologies={technologies} />
</BaseLayout>
