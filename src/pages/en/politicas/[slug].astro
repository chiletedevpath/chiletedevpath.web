---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PolicyDocument from "../../../components/PolicyDocument.astro";
import { policiesEn } from "../../../data/recursos.js";
export function getStaticPaths() {
  return policiesEn.map(policy => ({ params: { slug: policy.slug }, props: { policy } }));
}
const { policy } = Astro.props;
---
<BaseLayout title={`${policy.title} | Chilete DevPath`} description={policy.objective}>
  <PolicyDocument policy={policy} lang="en" />
</BaseLayout>
