{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chiletedevpath-contacto",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "chiletedevpath.com/api/contacto",
      "zone_name": "chiletedevpath.com"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://chiletedevpath.com",
    "TURNSTILE_HOSTNAMES": "chiletedevpath.com"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "EMAILJS_SERVICE_ID",
      "EMAILJS_TEMPLATE_ID",
      "EMAILJS_PUBLIC_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
