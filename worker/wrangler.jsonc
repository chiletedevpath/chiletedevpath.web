{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chiletedevpath-contacto",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://chiletedevpath.com",
    "TURNSTILE_HOSTNAMES": "chiletedevpath.com",
    "EMAILJS_SERVICE_ID": "service_qtj5rkm",
    "EMAILJS_TEMPLATE_ID": "template_qfaomfd",
    "EMAILJS_PUBLIC_KEY": "lVqMAbSHdWZlz4mUl"
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "EMAILJS_PRIVATE_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
